import glowvm
import gleam/int
import gleam/list
import wisp

pub fn start() {
  glowvm.serve(handle_request)
}

fn handle_request(_req: wisp.Request) -> wisp.Response {
  // Insert all list functions here
  let _ = list.length([1, 2, 3])
  let _ = list.count([1, 2, 3], where: fn(x) { x > 1 })
  let _ = list.reverse([1, 2, 3])
  let _ = list.is_empty([1, 2, 3])
  let _ = list.contains([1, 2, 3], any: 2)
  let _ = list.first([1, 2, 3])
  let _ = list.rest([1, 2, 3])
  // let _ = list.group([1, 2, 3], by: fn(x) { x % 2 })
  let _ = list.filter([1, 2, 3], keeping: fn(x) { x > 1 })
  let _ = list.filter_map([1, 2, 3], with: fn(x) { Ok(x * 2) })
  let _ = list.map([1, 2, 3], with: fn(x) { x * 2 })
  let _ = list.map2([1, 2], ["a", "b"], with: fn(i, x) { #(i, x) })
  let _ = list.map_fold(over: [1, 2, 3], from: 0, with: fn(acc, i) { #(acc + i, i * 2) })
  let _ = list.index_map([1, 2, 3], with: fn(x, i) { #(x, i) })
  let _ = list.try_map(over: [1, 2, 3], with: fn(x) { Ok(x * 2) })
  let _ = list.drop(from: [1, 2, 3], up_to: 1)
  let _ = list.take(from: [1, 2, 3], up_to: 1)
  let _ = list.new()
  let _ = list.wrap(1)
  let _ = list.append([1, 2], [3, 4])
  let _ = list.prepend(to: [2, 3], this: 1)
  let _ = list.flatten([[1, 2], [3, 4]])
  let _ = list.flat_map([1, 2], with: fn(x) { [x, x] })
  let _ = list.fold(over: [1, 2, 3], from: 0, with: fn(acc, x) { acc + x })
  let _ = list.fold_right(over: [1, 2, 3], from: 0, with: fn(acc, x) { acc + x })
  let _ = list.index_fold(over: [1, 2, 3], from: 0, with: fn(acc, x, i) { acc + x + i })
  let _ = list.try_fold(over: [1, 2, 3], from: 0, with: fn(acc, x) { Ok(acc + x) })
  let _ = list.fold_until(over: [1, 2, 3], from: 0, with: fn(acc, x) { list.Continue(acc + x) })
  let _ = list.find(in: [1, 2, 3], one_that: fn(x) { x > 1 })
  let _ = list.find_map(in: [1, 2, 3], with: fn(x) { Ok(x) })
  let _ = list.all(in: [1, 2, 3], satisfying: fn(x) { x > 0 })
  let _ = list.any(in: [1, 2, 3], satisfying: fn(x) { x > 2 })
  let _ = list.zip([1, 2], ["a", "b"])
  let _ = list.strict_zip([1, 2], ["a", "b"])
  let _ = list.unzip([#(1, "a"), #(2, "b")])
  let _ = list.intersperse([1, 2, 3], with: 0)
  let _ = list.unique([1, 1, 2])
  let _ = list.sort([3, 1, 2], by: int.compare)
  let _ = list.repeat(item: "a", times: 3)
  let _ = list.split(list: [1, 2, 3], at: 1)
  let _ = list.split_while(list: [1, 2, 3], satisfying: fn(x) { x < 2 })
  let _ = list.key_find(in: [#("a", 1)], find: "a")
  let _ = list.key_filter(in: [#("a", 1)], find: "a")
  let _ = list.key_pop([#("a", 1)], "a")
  let _ = list.key_set([#("a", 1)], "b", 2)
  let _ = list.each([1, 2, 3], fn(_) { Nil })
  let _ = list.try_each(over: [1, 2, 3], with: fn(_) { Ok(Nil) })
  let _ = list.partition([1, 2, 3], with: fn(x) { x > 1 })
  let _ = list.permutations([1, 2])
  let _ = list.window([1, 2, 3], by: 2)
  let _ = list.window_by_2([1, 2, 3])
  let _ = list.drop_while(in: [1, 2, 3], satisfying: fn(x) { x < 2 })
  let _ = list.take_while(in: [1, 2, 3], satisfying: fn(x) { x < 2 })
  let _ = list.chunk([1, 1, 2], by: fn(x) { x })
  let _ = list.sized_chunk([1, 2, 3, 4], into: 2)
  let _ = list.reduce(over: [1, 2, 3], with: fn(a, b) { a + b })
  let _ = list.scan(over: [1, 2, 3], from: 0, with: fn(acc, x) { acc + x })
  let _ = list.last([1, 2, 3])
  let _ = list.combinations([1, 2, 3], by: 2)
  let _ = list.combination_pairs([1, 2, 3])
  let _ = list.interleave([[1, 2], [3, 4]])
  let _ = list.transpose([[1, 2], [3, 4]])
  // let _ = list.shuffle([1, 2, 3])
  let _ = list.max(over: [1, 2, 3], with: int.compare)
  // let _ = list.sample(from: [1, 2, 3], up_to: 2)

  wisp.ok() |> wisp.string_body("OK")
}
